# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies

# App lockfile SHOULD be committed (application repo) — pubspec.lock is not
# ignored here on purpose.

# IDE
.idea/
.vscode/
*.iml

# Platform folders are generated with `flutter create .`
# (CI regenerates + patches them every build — see tool/ci_prepare_android.sh)
android/
ios/
linux/
macos/
windows/
web/

# ---- Signing material: NEVER commit these ----
key.properties
**/key.properties
*.jks
*.keystore
keystore-credentials.txt
*.pem
*.p12

# Secrets / env
.env
.env.*

# Miscellaneous
*.log
.DS_Store
